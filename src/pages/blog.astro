                    <h2 class="text-gradient animate-on-scroll" style="font-size: 3.5rem; margin-bottom: 1.5rem;">TomoClub Blog</h2>
                    <p class="animate-on-scroll" style="color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin: 0 auto;">Exploring the intersection of technology, leadership, and human-centered learning.</p>
                </div>

                <script is:inline>
                  // Reveal the hero immediately -- it's always above the fold,
                  // so it shouldn't wait on IntersectionObserver + parsing the
                  // rest of this page's cards before it can appear (a real,
                  // user-reported issue on larger pages: the shared observer
                  // in script.js only runs after the WHOLE page finishes
                  // parsing and DOMContentLoaded fires). Placed right after
                  // the hero markup and before the heavy grid below, so at
                  // this point in parsing only the hero's elements exist yet.
                  // The double rAF matters: adding .visible in the very same
                  // tick as the initial opacity:0 paint gives the browser
                  // nothing to transition FROM, so the CSS transition never
                  // plays -- it just jumps straight to the end state. Waiting
                  // two animation frames guarantees the browser has actually
                  // painted the "before" state first, so the transition to
                  // .visible plays properly.
                  const heroEls = document.querySelectorAll('.animate-on-scroll');
                  heroEls.forEach((el, i) => { el.style.transitionDelay = `${i * 120}ms`; });
                  requestAnimationFrame(() => requestAnimationFrame(() => {
                    heroEls.forEach(el => el.classList.add('visible'));
                  }));
                </script>

