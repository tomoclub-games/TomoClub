---
---
<nav>
    <div class="nav-container">
        <a href="/" class="logo" style="text-decoration: none;">
            <span style="color: var(--teal);">To</span><span style="color: var(--gold);">mo</span><span style="color: var(--crimson);">Club</span>
        </a>
        <div style="display: flex; align-items: center; gap: 1rem;">
            <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme" style="background: var(--surface); border: 1px solid var(--border-color); cursor: pointer; color: var(--navy); display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; transition: var(--transition);">
                <i data-lucide="moon" class="theme-icon-moon" style="width: 18px; height: 18px;"></i>
                <i data-lucide="sun" class="theme-icon-sun" style="width: 18px; height: 18px; display: none;"></i>
            </button>
            <a href="/" class="nav-home-btn">
                <i data-lucide="home"></i> Back to Home
            </a>
        </div>
    </div>
</nav>

<style>
    /* Base "nav" positioning/background/blur/scrolled-state styles come
       from the shared global.css (identical floating-pill-nav rule used by
       every other page) -- don't redeclare them here. A page-scoped
       duplicate of that rule used to sit here and, due to equal CSS
       specificity plus cascade order, silently won over global.css's
       nav.scrolled state, so the nav never visibly shrank on scroll on
       any page using this component even once the JS toggle was added. */
    .nav-container {
        display: flex;
        width: 100%;
        justify-content: space-between;
        align-items: center;
    }

    .nav-home-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: #0F172A;
        font-weight: 700;
        padding: 0.6rem 1.2rem;
        background: #FFFFFF;
        border-radius: 999px;
        transition: all 0.3s ease;
    }

    .nav-home-btn:hover {
        background: #F1F5F9;
        transform: translateY(-1px);
    }
</style>
