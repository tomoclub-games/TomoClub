---
import '../styles/global.css';
import MiniNav from '../components/MiniNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}

const { title, description, path, ogImage = 'https://www.tomoclub.org/assets/og-image.png' } = Astro.props;
const canonicalUrl = new URL(path, 'https://www.tomoclub.org').toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-FEGGQ2ZDMT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-FEGGQ2ZDMT');
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style is:global>
        .contact-container {
            padding: 120px 0 80px;
            max-width: 1000px;
            margin: 0 auto;
        }
        .contact-content {
            background: var(--surface);
            padding: 2rem;
            border-radius: 24px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            min-height: 800px;
            display: flex;
            flex-direction: column;
        }
        .contact-header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem 1rem 0;
        }
        .contact-header h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: var(--navy);
        }
        .contact-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .form-iframe-wrapper {
            flex-grow: 1;
            width: 100%;
            height: 1200px; /* High enough to avoid double scrollbars on the form */
            border: none;
            border-radius: 12px;
            overflow: hidden;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        @media (max-width: 768px) {
            .contact-header h1 {
                font-size: 2.25rem;
            }
            .contact-content {
                padding: 1rem;
                border-radius: 16px;
            }
            .form-iframe-wrapper {
                height: 1500px; /* More height for mobile stacked fields */
            }
        }
    </style>

    <!-- Open Graph / Social Media Meta Tags -->
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content="TomoClub">
    <meta property="og:url" content={canonicalUrl}>

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
</head>
<body>
    <MiniNav />

    <slot />

    <Footer />

    <script is:inline src="https://cdn.jsdelivr.net/npm/lucide@0.344.0/dist/umd/lucide.min.js"></script>
    <script is:inline>
        lucide.createIcons();

        // Theme Toggle Logic
        const themeToggleBtn = document.getElementById('theme-toggle');
        const updateIcons = () => {
            const isDark = document.body.classList.contains('dark-theme');
            document.querySelectorAll('.theme-icon-moon').forEach(icon => icon.style.display = isDark ? 'none' : 'block');
            document.querySelectorAll('.theme-icon-sun').forEach(icon => icon.style.display = isDark ? 'block' : 'none');
        };

        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.body.classList.add('dark-theme');
            updateIcons();
        }

        themeToggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('dark-theme');
            const isDark = document.body.classList.contains('dark-theme');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateIcons();
        });

        // Navigation Background on Scroll (matches the shared script.js
        // behavior used on every other page)
        const navEl = document.querySelector('nav');
        if (navEl) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    navEl.classList.add('scrolled');
                } else {
                    navEl.classList.remove('scrolled');
                }
            });
        }
    </script>
    <slot name="scripts-extra" />
</body>
</html>
