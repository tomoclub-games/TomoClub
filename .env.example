# Required
ANTHROPIC_API_KEY=            # from console.anthropic.com; stays on the server
ADMIN_PASSWORD=               # long random password for /admin (leads); admin is off if empty
IP_HASH_SALT=                 # any long random string

# Recommended
ADMIN_USER=tomoclub
TRUST_PROXY=true              # set when running behind Render, Railway, Fly or a load balancer
DATA_DIR=/data                # put this on a persistent disk so leads survive restarts

# Optional
ANTHROPIC_MODEL=claude-sonnet-5-5        # writes the answers
ANTHROPIC_FAST_MODEL=claude-haiku-5-5    # turns questions into search words
LEAD_WEBHOOK_URL=             # also POST each lead as JSON (Apps Script, Zapier, Slack workflow)
MAX_PAGES=40
MAX_PDFS=15
CRAWL_TIME_LIMIT_SEC=240
CRAWL_DELAY_MS=400
REUSE_DAYS=7
LIMIT_CRAWLS_PER_HOUR=6
LIMIT_QUESTIONS_PER_HOUR=60
LIMIT_LEADS_PER_HOUR=5
DAILY_QUESTION_LIMIT=400   # all visitors together
DAILY_CRAWL_LIMIT=40       # new district websites per day, all visitors together
PORT=3000
