# Superseded pages kept for reference, not deployed.
archive/

# Local-only files. Git deploys never include these; this keeps `vercel deploy` from the CLI in line.
.env*
scratch/
for_parents.docx
__pycache__/
*.pyc
.claude/settings.local.json

# Page build sources (build_pages.py). Only the generated HTML is deployed.
_partials/
pages/

# Internal project files: docs, tooling, Claude skills, build and maintenance scripts, notes.
docs/
tools/
.claude/
*.py
*.md
*.docx

# Content data used only by the build scripts (data/podcasts_data.js).
data/
